{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**"
    },
    "api/notifications-api.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**"
    },
    "api/search-api.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "**"
    }
  },
  "rewrites": [
    {
      "source": "/api/notifications-api.php",
      "destination": "/api/notifications-api.php"
    },
    {
      "source": "/api/search-api.php",
      "destination": "/api/search-api.php"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ]
}
